AUTH_SECRET="" # Set to a secure random value. Read more: https://authjs.dev/getting-started/deployment
AUTH_TRUST_HOST=true # Local/proxy testing only; remove in production unless your host/proxy is trusted
HMAC_SECRET_KEY='some-secret' # create this by running `openssl rand -base64 32`
AUTH_URL='' # Set to your ngrok URL for testing or your production URL after deploy
NEXT_PUBLIC_APP_ID='app_1234567890' # APP ID from the developer portal
RP_SIGNING_KEY='' # RP signing key from the Developer Portal (IDKit / Relying Party)
RP_ID='' # Your relying party id

# OpenRouter (server-side only, powers the Workline AI Smart Split engine)
# Sign up at https://openrouter.ai/keys
OPENROUTER_API_KEY=''
OPENROUTER_MODEL='openai/gpt-oss-120b:free'

# === Workline FX deployer wallet (DO NOT COMMIT) ===
# Generate one with: node scripts/gen-deployer.mjs
# Fund the public address with mainnet WLD on World Chain (chainId 480)
# before running scripts/deploy-fx-mainnet.sh.
DEPLOYER_PRIVATE_KEY=''
DEPLOYER_ADDRESS=''

# === Workline FX on-chain stack (World Chain mainnet, chain id 480) ===
# Filled in automatically after running scripts/deploy-fx-mainnet.sh.
# These are the predicted CREATE addresses for the deployer at nonce 0/1/2,
# so they will be deterministic if the deployer wallet is freshly generated
# and never used outside the deploy flow.
NEXT_PUBLIC_FX_USDC_ADDRESS=''
NEXT_PUBLIC_FX_WMXN_ADDRESS=''
NEXT_PUBLIC_FX_POOL_ADDRESS=''
NEXT_PUBLIC_WORLDCHAIN_RPC='https://worldchain-mainnet.g.alchemy.com/public'
